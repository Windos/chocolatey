<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>azureaccount-vscode</id>
    <version>0.13.0.20261005</version>
    <packageSourceUrl>https://github.com/Windos/chocolatey/tree/master/_deprecated/azureaccount-vscode</packageSourceUrl>
    <owners>Josh King</owners>
    <title>[Deprecated] Azure Account VSCode Extension</title>
    <authors>Microsoft</authors>
